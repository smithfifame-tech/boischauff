# ------------------------------------------------------------------
# BoisChauff+ — variables d'environnement (copier en .env.local)
# Aucune valeur secrète ne doit être commitée.
# ------------------------------------------------------------------

# Base PostgreSQL (Supabase : utiliser le pooler, port 6543)
DATABASE_URL=postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:6543/postgres
# Optionnel : URL utilisée par les migrations au build (par défaut DATABASE_URL)
# DATABASE_MIGRATION_URL=
# DATABASE_SCHEMA=boischauff

# Secret de signature des sessions (48+ caractères aléatoires : openssl rand -base64 48)
AUTH_SECRET=

# URL publique du site (liens des e-mails, retours de paiement)
SITE_URL=https://votre-domaine.com

# Administrateur initial (créé une seule fois au premier build s'il n'existe aucun admin)
# Hash bcrypt du mot de passe temporaire : node -e "console.log(require('bcryptjs').hashSync('motdepasse',12))"
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD_HASH=

# ---------------- Paiement SasPay — https://docs.saspay.me (côté serveur uniquement) ----------------
# Tant que la clé et le secret ne sont pas renseignés, le site fonctionne en MODE DÉMONSTRATION.
# sandbox = tests (clé sk_test_…, hôte sandbox-api.saspay.me) ; live = réel (clé sk_live_…, hôte api.saspay.me)
SASPAY_ENVIRONMENT=sandbox
SASPAY_SECRET_KEY=
# signing_secret affiché UNE SEULE FOIS à la création du webhook SasPay
# URL du webhook : https://votre-domaine/api/webhooks/saspay — événement : transaction.success
SASPAY_WEBHOOK_SECRET=
# "off" pour interdire le mode démonstration même sans SasPay
# PAYMENT_DEMO_MODE=auto

# ---------------- E-mails (SMTP ou Resend) ----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=false
# RESEND_API_KEY=
MAIL_FROM="BoisChauff+ <commandes@votre-domaine.com>"
# Adresse de réception des commandes si non définie dans l'administration
ORDER_NOTIFICATION_EMAIL=smithfifame@gmail.com
